PROJECT_ROOT=.
RAW_INPUT_PATH=Data/StockHistory/*.csv
RAW_INPUT_MAX_FILES=100
RAW_INPUT_YEARS_BACK=8
PARQUET_OUTPUT_PATH=output/parquet/stocks
CLEAN_OUTPUT_PATH=output/parquet/stocks_clean
INDICATOR_OUTPUT_PATH=output/parquet/stocks_indicators
PORTFOLIO_OUTPUT_PATH=output/parquet/portfolio
EXPORT_OUTPUT_PATH=output/exports/final_portfolio.csv
GROWTH_START_END_OUTPUT_PATH=output/parquet/growth_start_end
GROWTH_CAGR_OUTPUT_PATH=output/parquet/growth_cagr
GROWTH_RANKED_OUTPUT_PATH=output/parquet/growth_ranked
GROWTH_EXPORT_OUTPUT_PATH=output/exports/Top20_Growth_Portfolio.csv
